{
  "name": "@supasayan/openspot",
  "version": "1.0.2",
  "description": "OpenSpot — Cross-platform Music Downloader, Player & Song Lore Platform with High-Res Audio, Karaoke Synced Lyrics & Liquid Glass UI.",
  "main": "main.js",
  "productName": "OpenSpot",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "openspot": "bin/cli.js",
    "openspot-cli": "bin/cli.js"
  },
  "keywords": [
    "ytm",
    "youtube-music",
    "youtube-music-downloader",
    "music-downloader",
    "audio-downloader",
    "yt-dlp",
    "yt-dlp-gui",
    "flac-downloader",
    "high-res-audio",
    "cli-music-player",
    "npx-downloader",
    "metadata-tagger"
  ],
  "author": "Sayan Pramanick",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sayan2302/OpenSpot.git"
  },
  "bugs": {
    "url": "https://github.com/sayan2302/OpenSpot/issues"
  },
  "homepage": "https://github.com/sayan2302/OpenSpot#readme",
  "files": [
    "bin",
    "server/*.js",
    "server/routes",
    "server/services",
    "server/utils",
    "client/dist",
    "main.js",
    "README.md"
  ],
  "dependencies": {
    "@supasayan/openspot": "^1.0.1",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "ffmpeg-static": "^5.2.0",
    "ytmusic-api": "^5.0.0"
  },
  "scripts": {
    "start": "npx concurrently \"npm run start --prefix server\" \"npm run dev --prefix client\"",
    "dev": "npx concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "prepublishOnly": "npm run build",
    "install-all": "npm install --prefix server && npm install --prefix client",
    "app:dev": "npx concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\" \"npx wait-on http://localhost:5173 && npx wait-on http://localhost:3001 && npx electron .\"",
    "app:build": "npm run build --prefix client && npx electron-builder --mac"
  },
  "build": {
    "appId": "com.sayan.ytm",
    "productName": "YTM",
    "directories": {
      "output": "dist-app"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music"
    },
    "dmg": {
      "title": "Install YTM"
    },
    "asar": true,
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**/*"
    ],
    "files": [
      "main.js",
      "server/**/*",
      "client/dist/**/*",
      "package.json"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^24.13.3",
    "wait-on": "^9.0.10"
  }
}
